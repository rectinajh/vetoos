# VetoOS environment — copy to .env and fill in. .env is gitignored; never commit keys.
# Full walkthrough: docs/TESTNET_SETUP.md
#
# IMPORTANT: the testnet faucet only serves addresses that have deposited on
# mainnet. The flow is therefore:
#   1. YOUR real HL account claims 1,000 mock USDC (app.hyperliquid-testnet.xyz/drip)
#   2. approve an AGENT (API) wallet for your testnet account (More → API, or `pnpm keygen`)
#   3. the agent key signs trades; it can never withdraw.

# AGENT wallet private key (hex, 0x-prefixed). The ONLY key in this repo.
HL_PRIVATE_KEY=0x...

# YOUR testnet ACCOUNT address the broker trades for (0x-prefixed).
# Not the agent's address — the account that claimed the faucet.
HL_ACCOUNT_ADDRESS=0x...

# Optional builder attribution (PRD §13.7 placeholder is fine for testnet).
# HL_BUILDER_ADDRESS=0x...
# HL_BUILDER_FEE_TENTHS_BPS=10

# Optional overrides
# VETOOS_POLICY=configs/policy.demo.json
# VETOOS_STATE_DIR=logs
