# VetoOS environment — copy to .env and fill in. .env is gitignored; never commit keys.
# See docs/TESTNET_SETUP.md for the full walkthrough.

# Testnet wallet private key (hex, 0x-prefixed). The ONLY place a key exists.
# Use a dedicated testnet account or an agent (API) wallet approved by it.
HL_PRIVATE_KEY=0x...

# The testnet account address the broker trades for (0x-prefixed).
HL_ACCOUNT_ADDRESS=0x...

# Optional builder attribution (PRD §13.7 placeholder is fine for testnet).
# HL_BUILDER_ADDRESS=0x...
# HL_BUILDER_FEE_TENTHS_BPS=10

# Optional overrides
# VETOOS_POLICY=configs/policy.demo.json
# VETOOS_STATE_DIR=logs
